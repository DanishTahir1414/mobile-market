# Copy to .env and fill in. Secrets have no defaults: the service will not start without them.
NODE_ENV=development
PORT=4001
DATABASE_URL=postgres://mobilemarket:change-me@127.0.0.1:5432/mobilemarket_identity
DATABASE_SSL=false
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=
IP_HMAC_KEY=
# Exact origins of the website, comma separated. No wildcards.
ALLOWED_ORIGINS=http://localhost:3000
# Must be true in production; false only for plain-http local development.
COOKIE_SECURE=false
# Number of reverse proxies in front of the service (0 = none). Wrong values let clients fake their IP.
TRUST_PROXY=0
